# Runtime artifacts
/data/*
!/data/.gitkeep
/runs/*
!/runs/.gitkeep
/repos/*
!/repos/.gitkeep
/worktrees/*
!/worktrees/.gitkeep
*.sqlite
*.sqlite3
*.db
*.log
